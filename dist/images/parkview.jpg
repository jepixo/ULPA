parkviewhallstudents@outlook.com)\u003c\/a\u003e\u003c\/div\u003e\u003cdiv\u003e\u0026nbsp;\u003c\/div\u003e\u003cp style=\"font-size: 100%;\"\u003e\u0026nbsp;\u003c\/p\u003e","backupValue":null,"version":1},"button1":{"type":"Button","id":"f_65ed2274-fa3c-457b-9327-8e792bfcf608","defaultValue":false,"text":"","link_type":null,"page_id":null,"section_id":null,"url":"","new_target":null},"background1":{"type":"Background","id":"f_46e37cca-4136-46d0-b5b2-9df06d51af19","defaultValue":true,"url":"","textColor":"light","backgroundVariation":"","sizing":"cover","videoUrl":"","videoHtml":""}}}],"components":{"text2":{"type":"RichText","id":"f_4f73ce54-f6c3-40d9-b764-a5582de9bf67","defaultValue":null,"value":"{\"type\"=\u0026gt;\"RichText\", \"id\"=\u0026gt;nil, \"value\"=\u0026gt;\"\u003cdiv\u003e\u003cstrong\u003e\u003cspan\u003eBuilt in 2005,and due to our central location,between the city of Limerick and the University of Limerick,is specifically designed with the student in mind.,\u003c\/span\u003e\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003e\u003cspan\u003eparkviewhallstudents.com complex\u00a0is a secure and gated Student Complex,with free parking,and accessed by a phone and card operated system.\u003c\/span\u003e\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003e\u003cspan\u003eAccommodates approx. 220 students,and is normally fully booked during each Academic year,with Irish and overseas students from affiliated Universities of the University of Limerick.We offer bright clean spacious,modern, highly maintained,comfortable, apartments,for the discerning student.\u003c\/span\u003e\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003e\u003cspan\u003eMain access to apartment block has own card operated private entrance and lift.\u003c\/span\u003e\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003e\u003cspan\u003eAccess to each apartment and room has it own protected key system.\u003c\/span\u003e\u003c\/strong\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cstrong\u003e\u00a0\u003c\/strong\u003e\u003c\/div\u003e\", \"backupValue\"=\u0026gt;nil, \"version\"=\u0026gt;nil, \"text_type\"=\u0026gt;\"body\"}","backupValue":null,"version":null},"text1":{"type":"RichText","id":"f_70c8cc99-7763-4295-9655-56f33f4c7171","defaultValue":null,"value":"{\"type\"=\u0026gt;\"RichText\", \"id\"=\u0026gt;nil, \"value\"=\u0026gt;\"\u003cdiv\u003e\u00a0\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u00a0\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u003cstrong\u003eEmail:mikey2_@hotmail.com\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u00a0\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003eMobile no:\u003cstrong\u003e+353(0)866056307\u003c\/strong\u003e.\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e(to view location,copy and save this link into Google Maps)\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u003cstrong\u003e52.664897, -8.601666\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\", \"backupValue\"=\u0026gt;nil, \"version\"=\u0026gt;nil, \"text_type\"=\u0026gt;\"heading\"}","backupValue":null,"version":null}}},"text2":{"type":"RichText","id":"f_dd6c38fc-b396-4d97-a720-7debb818b015","defaultValue":false,"alignment":"auto","value":"\u003cdiv class=\"s-rich-text-wrapper\" style=\"display: block;\"\u003e\u003cp\u003eStudent Accommodation\u003c\/p\u003e\u003c\/div\u003e","backupValue":"","version":1},"text1":{"type":"RichText","id":"f_2527ac43-abf9-4ee2-be3f-caf158ab90b1","defaultValue":false,"alignment":"auto","value":"\u003cp style=\"font-size: 60%;\"\u003eParkview Hall\u003c\/p\u003e","backupValue":null,"version":1},"background1":{"type":"Background","id":"f_5ac8ec98-dfd1-4271-b28f-088e61bc4d75","defaultValue":null,"url":"","textColor":"light","backgroundVariation":null,"sizing":null,"userClassName":null,"linkUrl":null,"linkTarget":null,"videoUrl":"","videoHtml":"","storageKey":null,"storage":null,"format":null,"h":null,"w":null,"s":null,"useImage":null,"noCompression":null,"focus":{},"backgroundColor":null},"slideSettings":{"type":"SlideSettings","id":"f_381f8fec-6556-437d-b80a-de0b71b0b2b6","defaultValue":null,"show_nav":true,"show_nav_multi_mode":null,"nameChanged":true,"hidden_section":null,"name":"Enquiries.","sync_key":null,"layout_variation":"text-two-button","display_settings":{},"padding":{},"layout_config":null}}},{"type":"Slide","id":"f_6902d164-75f2-445b-a546-33210fa4755d","defaultValue":null,"template_id":null,"template_name":"text","template_version":null,"components":{"repeatable1":{"type":"Repeatable","id":"f_876d6555-5b6c-4d29-a360-9bdc32764ded","defaultValue":false,"list":[{"type":"RepeatableItem","id":"f_74d49473-875f-4959-8ea9-b70614688544","defaultValue":null,"components":{"text2":{"type":"RichText","id":"f_1ad1101a-3c42-4690-8408-4f7b114e2d37","defaultValue":false,"alignment":"auto","value":"\u003cul\u003e\u003cli\u003e\u003cp style=\"font-size: 100%;\"\u003e\u003cspan class=\"s-text-color-blue\"\u003e\u003cu\u003e\u003cstrong\u003eENERGY USAGE COST IS NOT INCLUDED IN RENT.\u003c\/strong\u003e\u003c\/u\u003e\u003c\/span\u003e\u003c\/p\u003e\u003c\/li\u003e\u003cli\u003e\u003cp style=\"font-size: 100%;\"\u003e\u003cstrong\u003eUnlimited hispeed Wi - Fi, free to all apartments.\u003c\/strong\u003e\u003c\/p\u003e\u003c\/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEnergy System (Electrical)\u003cbr\u003eEnergy costs are paid directly to an offsite Utility Supply Company,using a special card pay system. Students have full control of these costs themselves.\u003c\/strong\u003e\u003c\/p\u003e\u003c\/li\u003e\u003c\/ul\u003e\u003cul\u003e\u003cli\u003e\u00a0\u003c\/li\u003e\u003c\/ul\u003e","backupValue":null,"version":1},"text1":{"type":"RichText","id":"f_9cd91d90-e5b7-4e33-8140-be77fe3298bd","defaultValue":false,"alignment":"auto","value":"\u003cp class=\"s-text-color-green\"\u003e\u00a0\u003c\/p\u003e\u003cp class=\"s-text-color-green\"\u003e\u003cstrong\u003e\u00a0\u003c\/strong\u003e\u003c\/p\u003e","backupValue":null,"version":1},"button1":{"type":"Button","id":"f_411a5f3d-4e51-40dc-8414-9632d64794d9","defaultValue":true,"text":"","link_type":null,"page_id":null,"section_id":null,"url":"","new_target":null}}}],"components":{"text2":{"type":"RichText","id":"f_a3c0ad9e-e86b-4305-8a25-fd586dff7e93","defaultValue":null,"value":"{\"type\"=\u0026gt;\"RichText\", \"id\"=\u0026gt;nil, \"value\"=\u0026gt;\"\u003cdiv\u003e\u003cspan\u003e\u003cstrong\u003eYou will have your own room.\u003cbr\u003e Sharing large bathroom\/shower,living area,and fully equipped kitchen with 1 or 2 other students.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e If booking for full academic year \u20ac275\/month\u00a0(Sept'15 - May'16):\u003cbr\u003e Rental period is from 1st.Sept thro to 31st.May. \u003cbr\u003e Total = \u20ac2475.(\u20ac275\/Month)\u003cbr\u003e\u003cbr\u003e Semester 1 only = \u20ac290\/month.\u003cbr\u003e Rental period is from Sept.1st. to Dec.31st.\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u003cstrong\u003eTotal = \u20ac1160\u003cbr\u003e . \u003cbr\u003eSemester 2 only = \u20ac290\/month.\u003cbr\u003e Rental period is from 1st.Feb.to 31st.May .\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u003cstrong\u003eTotal = \u20ac1160\u003cbr\u003e\u003cbr\u003e\u00a0Booking deposit : \u20ac100,and will be returned to Student on day of departure.\u00a0(Subject to\u00a0Letting\u00a0Agreement.\u003c\/strong\u003e\u003cstrong\u003e\u003cbr\u003ePayment will be accepted on a 2 monthly basis only,or in one lump sum.\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u00a0\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u003cstrong\u003e\u003cstrong\u003eSummer Letting: (June - Aug): \u20ac200\/month + (deposit and energy cost)\u003c\/strong\u003e\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\\n\u003cp\u003e\u00a0\u003c\/p\u003e\\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eThese costs are included in the rent. (Internet\/Wifi,Parking,Water usage,Refuse collection,Multi-channel TV connection,etc).\u003c\/strong\u003e\u003c\/span\u003e\u003c\/p\u003e\\n\u003cul\u003e\\n\u003cli\u003e\u003cspan\u003e\u003cstrong\u003eEnergy usage cost is not included in rent.\u003c\/strong\u003e\u003c\/span\u003e\u003c\/li\u003e\\n\u003cli\u003e\u003cspan\u003e\u003cstrong\u003eUnlimited\u00a0hispeed Wi - Fi, free to all apartments.\u003c\/strong\u003e\u003c\/span\u003e\u003c\/li\u003e\\n\u003cli\u003e\\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eEnergy System (Electrical)\u003cbr\u003eEnergy costs are paid directly to an offsite Utility Supply Company,using a special card pay system. Students have full control of these costs themselves.\u003c\/strong\u003e\u003c\/span\u003e\u003c\/p\u003e\\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eEnergy usage depends on time of year and weather conditions.\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e\u003cspan\u003e\u003cstrong\u003eAverage cost to Student for Semester 1 and 2 = \u20ac6 to \u20ac9 weekly\u00a0(calculated over the 38 week Academic year)*When sharing with 2 other students.\u003c\/strong\u003e\u003c\/span\u003e\u003c\/p\u003e\\n\u003cp\u003e\u003cbr\u003e\u003cspan\u003e\u003cstrong\u003eLaundrette\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e\u003cspan\u003e\u003cstrong\u003eThere is a self-service laundrette in the student complex next to reception.\u003c\/strong\u003e\u003c\/span\u003e\u003c\/p\u003e\\n\u003c\/li\u003e\\n\u003c\/ul\u003e\", \"backupValue\"=\u0026gt;nil, \"version\"=\u0026gt;nil, \"text_type\"=\u0026gt;\"body\"}","backupValue":null,"version":null},"text1":{"type":"RichText","id":"f_1782ce52-2614-4248-9bbf-fa751eeef1b7","defaultValue":null,"value":"{\"type\"=\u0026gt;\"RichText\", \"id\"=\u0026gt;nil, \"value\"=\u0026gt;\"\u003cdiv\u003e\\n\u003cdiv\u003e\u003cspan\u003e\u003cstrong\u003ePrice of a room in a 3 bedroom apartment.2016\/17.\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\\n\u003cdiv\u003e\u003cstrong\u003e\u003cspan\u003e\u00a0\u003c\/span\u003e\u003c\/strong\u003e\u003c\/div\u003e\\n\u003c\/div\u003e\", \"backupValue\"=\u0026gt;nil, \"version\"=\u0026gt;nil, \"text_type\"=\u0026gt;\"heading\"}","backupValue":null,"version":null}}},"text2":{"type":"RichText","id":"f_1e384d54-4074-46c8-ae34-33cdc8166577","defaultValue":false,"alignment":"auto","value":"\u003cdiv class=\"s-rich-text-wrapper\" style=\"display: block;\"\u003e\u003cp class=\"s-rich-text-wrapper\"\u003e\u20ac450\/mth,for Academic year.(Sept - May) 9mths.\u003c\/p\u003e\u003cp\u003e\u20ac500\/mth,Erasmus students.(short term).\u003c\/p\u003e\u003cp\u003eEnergy usage is additional to monthly rental payment.\u003c\/p\u003e\u003cp\u003eCosts shared with 1\/2 other students in apt.\u003c\/p\u003e\u003cp\u003eAll other utilities included in rent.(Wifi\/bins etc).\u003c\/p\u003e\u003cp\u003eDeposit \u20ac100.\u003c\/p\u003e\u003cp\u003e\u003cspan style=\"display: inline-block\"\u003e\u0026nbsp;\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan style=\"display: inline-block\"\u003e\u0026nbsp;\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan style=\"display: inline-block\"\u003e\u0026nbsp;\u003c\/span\u003e\u003c\/p\u003e\u003c\/div\u003e","backupValue":"","version":1},"text1":{"type":"RichText","id":"f_d41eb290-48d8-42b2-82e0-fae83ba4016e","defaultValue":false,"alignment":"auto","value":"\u003cp style=\"font-size: 80%;\"\u003ePrices\u003c\/p\u003e","backupValue":null,"version":1},"background1":{"type":"Background","id":"f_8b375594-6b51-4b6c-b3ff-851362f8eeba","defaultValue":null,"url":"","textColor":"light","backgroundVariation":null,"sizing":null,"userClassName":null,"linkUrl":null,"linkTarget":null,"videoUrl":"","videoHtml":"","storageKey":null,"storage":null,"format":null,"h":null,"w":null,"s":null,"useImage":null,"noCompression":null,"focus":{},"backgroundColor":null},"slideSettings":{"type":"SlideSettings","id":"f_43be7fc1-e17e-4b33-8ee7-5cf0c57d5c2b","defaultValue":null,"show_nav":true,"show_nav_multi_mode":null,"nameChanged":null,"hidden_section":false,"name":"Prices","sync_key":null,"layout_variation":"text-one-text","display_settings":{},"padding":{},"layout_config":null}}},{"type":"Slide","id":"f_51fdb71b-5c89-47c0-a196-377377784fbb","defaultValue":null,"template_id":null,"template_name":"columns","template_version":null,"components":{"repeatable1":{"type":"Repeatable","id":"f_e64b2816-fc9e-443a-84e0-b190a00218f4","defaultValue":null,"list":[{"type":"RepeatableItem","id":"f_912f07bd-9cf7-4322-be4a-918a103b5176","defaultValue":null,"components":{"media1":{"type":"Media","id":"f_323d1cee-d6a6-4f7f-82e6-1abfbb9bed57","defaultValue":null,"video":{"type":"Video","id":"f_b6be6b33-058d-47f1-8f82-60b1194dbb77","defaultValue":null,"html":"","url":"","thumbnail_url":null,"maxwidth":700,"description":null},"image":{"type":"Image","id":"f_100767db-7eff-4039-b2c6-d19902d70524","defaultValue":true,"link_url":null,"thumb_url":null,"url":null,"caption":null,"description":null,"storageKey":null,"storage":null,"storagePrefix":null,"format":null,"h":null,"w":null,"s":null,"new_target":true,"noCompression":null,"cropMode":null,"focus":{}},"current":"image"},"text1":{"type":"RichText","id":"f_14d722d2-ab00-4318-9461-24c816618d04","defaultValue":false,"alignment":"auto","value":"\u003cp style=\"font-size: 80%;\"\u003e\u003cstrong\u003eAccommodation\u003c\/strong\u003e\u003c\/p\u003e","backupValue":null,"version":1},"text2":{"type":"RichText","id":"f_d4d14570-0709-4136-8a45-6564d282f5a6","defaultValue":false,"alignment":"","value":"","backupValue":null,"version":1},"text3":{"type":"RichText","id":"f_3501a198-665f-46e7-b8f0-444576a40d0f","defaultValue":false,"alignment":"auto","value":"\u003cp\u003e\u003cstrong\u003eEach apartment is fully furnished and fitted throughout, comes with a private balcony,also with a fully kitted out kitchen,complete with all essential cooking equipment (oven\/hob,fridge\/freezer,microwave,iron and board)\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cbr\u003e\u003cstrong\u003eAll rooms have a spacious wardrobe,desk\/lamp chair,bed,heater,also an independent Wi-fi system throughout each apartment,and alarm system.\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003eA large Bathroom,complete with Bath\/shower is shared with 2 other students.\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003eAll maintenance issues,are dealt with on day of reporting same,by our on site support\u003c\/strong\u003e.\u003c\/p\u003e","backupValue":null,"version":1},"button1":{"type":"Button","id":"f_c9a2c162-2e44-4be8-9ee6-e271759aa661","defaultValue":true,"text":"","link_type":null,"page_id":null,"section_id":null,"url":"","new_target":null}}},{"type":"RepeatableItem","id":"f_056aa4e9-8b01-44b1-90ce-f08163ef94b6","defaultValue":null,"components":{"media1":{"type":"Media","id":"f_75b1217c-bd1c-43d8-b6a3-0b1e84ce5b7a","defaultValue":null,"video":{"type":"Video","id":"f_75d00ea5-a015-4e1f-a106-97ae0affe40c","defaultValue":null,"html":"","url":"","thumbnail_url":null,"maxwidth":700,"description":null},"image":{"type":"Image","id":"f_ffd83a74-1822-4280-92f1-df1ef630e8a8","defaultValue":true,"link_url":null,"thumb_url":null,"url":null,"caption":null,"description":null,"storageKey":null,"storage":null,"storagePrefix":null,"format":null,"h":null,"w":null,"s":null,"new_target":true,"noCompression":null,"cropMode":null,"focus":{}},"current":"image"},"text1":{"type":"RichText","id":"f_1bca2636-fb6f-4b97-bf5a-c0cccf3658e8","defaultValue":false,"alignment":"auto","value":"\u003cp style=\"font-size: 80%;\"\u003eLocation\u003c\/p\u003e","backupValue":null,"version":1},"text2":{"type":"RichText","id":"f_c2747413-34df-4d0b-bde1-c70b6dc7ced6","defaultValue":false,"alignment":"auto","value":"\u003cp\u003e\u003cstrong\u003eWhere we are\u003c\/strong\u003e\u003c\/p\u003e","backupValue":null,"version":1},"text3":{"type":"RichText","id":"f_51709d04-7349-4c5a-888e-1dbf62cd7f90","defaultValue":false,"alignment":"auto","value":"\u003cp\u003e\u00a0\u003c\/p\u003e\u003cp style=\"font-size: 100%;\"\u003e\u003cstrong\u003eParkview Hall is ideally located between the University of Limerick and the City,and within 5 mins walking distance to large Shopping malls.\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003eLimerick School of Art and Design(LSAD)10minutes walking distance.\u003c\/strong\u003e\u003c\/p\u003e\u003cp style=\"font-size: 100%;\"\u003e\u003cstrong\u003ePublic transport bus stop located outside gate of complex.\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003eWalking distance to City Centre is approx.15 minutes.\u003c\/strong\u003e\u003cbr\u003e\u003cstrong\u003eWalking distance to University is approx.30 minutes.(when cycling 8 minutes).\u003c\/strong\u003e\u003cbr\u003e\u00a0\u003c\/p\u003e\u003cp\u003e\u00a0\u003c\/p\u003e","backupValue":null,"version":1},"button1":{"type":"Button","id":"f_57885bdc-0e50-4637-8544-2be15d0d9daa","defaultValue":true,"text":"","link_type":null,"page_id":null,"section_id":null,"url":"","new_target":null}}}],"components":{"text3":{"type":"RichText","id":"f_731ee4b4-7f5a-4008-859a-2c2234481601","defaultValue":null,"value":null,"backupValue":null,"version":null},"text2":{"type":"RichText","id":"f_69c0b09b-07f9-4459-804f-6e0851bc1ca0","defaultValue":null,"value":null,"backupValue":null,"version":null},"text1":{"type":"RichText","id":"f_6e9bcc87-d93f-456a-aaf3-e2d4dd33d35a","defaultValue":null,"value":null,"backupValue":null,"version":null},"media1":{"type":"Media","id":"f_902c2d14-9504-42ba-a2c4-0b2af7ce9435","defaultValue":null,"video":{"type":"Video","id":"f_c96d4102-14f2-4feb-ba04-78db8ce42e91","defaultValue":null,"html":"","url":"","thumbnail_url":null,"maxwidth":700,"description":null},"image":{"type":"Image","id":"f_762af341-792f-40c2-9b19-37faf8b2cb6a","defaultValue":true,"link_url":null,"thumb